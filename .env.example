# Yandex production: secrets belong in Lockbox, never NEXT_PUBLIC or this file.
NODE_ENV=production
TASKBATTLE_RUNTIME=yandex
APP_ORIGIN=
DB_PATH=/var/lib/taskbattle/taskbattle.sqlite
YANDEX_BUCKET=
YANDEX_BACKUP_BUCKET=
YANDEX_LOCKBOX_SECRET_ID=
# Confirm destination with owner before setting it:
YANDEX_DISK_PATH=
# Lockbox payload: CLEANUP_SECRET, MIGRATION_SECRET, MIGRATION_BRIDGE_KEY, YANDEX_DISK_TOKEN.
# Transition from the old host only; leave unset until verified cutover:
MIGRATION_SOURCE_ORIGIN=
# For a planned migration only; disables new rooms/attempts while existing ones continue:
MIGRATION_DRAIN=0

# Legacy Sites rollback profile only. Leave unset for Yandex:
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Old Sites worker only; never set on the Yandex server:
MIGRATION_TARGET_ORIGIN=

# Local integration test configuration; synthetic data only:
TEST_URL=http://127.0.0.1:3000
# TEST_PHOTO_DIR=/absolute/path/to/synthetic/test-photos
# TEST_STATE_FILE=/absolute/path/outside/repository/integration-state.json
