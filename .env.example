# Core functionality needs no application secrets. Sites supplies DB and BUCKET.
# Optional server-only Google Sheets export. Supply through hosting secrets, never NEXT_PUBLIC.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Teacher and attempt keys are generated per session, never configured here.
# Optional environment variables for integration tests only:
TEST_URL=http://127.0.0.1:5173
# TEST_PHOTO_DIR=/absolute/path/to/synthetic/test-photos
# TEST_STATE_FILE=/absolute/path/to/ignored/integration-state.json
