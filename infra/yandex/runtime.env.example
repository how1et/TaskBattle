# Non-secret configuration only. Install as /etc/taskbattle/runtime.env, mode 0640.
# Fill the IDs, bucket names and real HTTPS origin before starting services.
# APP_ORIGIN may use a verified sslip.io hostname for the reserved public IP;
# buying a domain is optional. It must exactly match the hostname passed to deploy.sh.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
DB_PATH=/var/lib/taskbattle/taskbattle.sqlite
YANDEX_BUCKET=
YANDEX_BACKUP_BUCKET=
YANDEX_LOCKBOX_SECRET_ID=
APP_ORIGIN=
YANDEX_DISK_PATH=
MIGRATION_DRAIN=0
# Old source origin; authenticated bridge key is stored in Lockbox:
MIGRATION_SOURCE_ORIGIN=
