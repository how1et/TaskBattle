{
    admin 127.0.0.1:2019
}

__DOMAIN__ {
    request_body {
        max_size 20MB
    }
    encode zstd gzip
    reverse_proxy 127.0.0.1:3000 {
        header_up X-TaskBattle-Client-IP {remote_host}
        header_up -CF-Connecting-IP
        header_up -True-Client-IP
    }
    # No access-log directive: room codes and student paths must not be logged.
    # The runtime checks /var/lib/taskbattle/maintenance before handling requests.
}
